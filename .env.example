# ============================================
# CLOUD AI PROVIDER CONFIGURATION
# ============================================

# Primary: Hugging Face (100% FREE)
# Get token from: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your_huggingface_token_here

# Optional: AssemblyAI (Free trial - $5 credit)
# Get from: https://www.assemblyai.com/dashboard/signup
ASSEMBLYAI_KEY=your_assemblyai_key_here

# Optional: Deepgram (Free tier - $200 credit)
# Get from: https://console.deepgram.com/signup
DEEPGRAM_KEY=your_deepgram_key_here

# Optional: OpenAI (Pay-as-you-go)
# Get from: https://platform.openai.com/api-keys
OPENAI_KEY=your_openai_key_here

# ============================================
# DATABASE
# ============================================
DATABASE_URL="file:./dev.db"

# ============================================
# REDIS (For job queue)
# ============================================
REDIS_URL="redis://localhost:6379"

# ============================================
# APP CONFIGURATION
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
MAX_FILE_SIZE=524288000
AI_PROVIDER="huggingface"
NODE_ENV="development"
